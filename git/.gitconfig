[include]
    path = ~/.gitconfig.local
[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true
        writeCommitGraph = true

[merge]
        conflictstyle = zdiff3
[transfer]
        fsckobjects = true
[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
        autoupdate = true
[core]
        excludesfile = ~/.gitignore_global
        untrackedCache = true
        pager = delta
[interactive]
        diffFilter = delta --color-only
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[delta]
	navigate = true
	dark = true
	syntax-theme = Catppuccin Macchiato
[credential "https://adc.github.trendmicro.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://github.trendmicro.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
